{
  "name": "perfect",
  "version": "0.2.0",
  "private": true,
  "description": "Perfect — give Cursor hands in your Chrome via MCP",
  "bin": {
    "perfect-mcp": "./packages/mcp-server/dist/index.js",
    "perfect": "./packages/mcp-server/dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "build": "npm run build -w @perfect/protocol && npm run build -w perfect-mcp && npm run build -w @perfect/extension",
    "typecheck": "npm run typecheck -w @perfect/protocol && npm run typecheck -w perfect-mcp && npm run typecheck -w @perfect/extension",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.cjs --project=fixtures",
    "test:e2e:extension": "playwright test -c tests/e2e/playwright.config.cjs --project=extension",
    "test:e2e:report": "playwright test -c tests/e2e/playwright.config.cjs --project=fixtures && echo 'Report → docs/capability-report.md'",
    "test:e2e:all": "playwright test -c tests/e2e/playwright.config.cjs",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pack:extension": "npm run build -w @perfect/extension && node scripts/pack-extension.mjs",
    "demo": "npm run demo -w perfect-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.10",
    "playwright": "^1.62.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
